# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# --- Free-tier engine (server only) ---
# Your Anthropic key powers the FREE tier (cheapest model, strictly rate-limited).
# Stays on the server; never sent to the browser. BYOK users don't touch this —
# they run on their own key. Leave unset if you don't want a shared free tier.
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (client + auth) ---
# From your Supabase project: Settings -> API. The anon key is public by design;
# security comes from Row Level Security + Auth, not from hiding it.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Same values, server-side (the function falls back to the VITE_ ones on Vercel).
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR-ANON-KEY

# REQUIRED in production for tamper-proof free-tier rate limiting. Supabase ->
# Settings -> API -> "service_role" secret. Bypasses RLS — keep SERVER-ONLY,
# never VITE_, never in client code, never committed.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Cost controls (server only) ---
# Free-tier per-user limits (default: strict 1/hour, 2/day — a taste, then BYOK).
# FREE_LIMIT_HOUR=1
# FREE_LIMIT_DAY=2

# Hard cap on TOTAL free-tier generations/day across ALL users — protects your
# Anthropic bill if traffic spikes. 0 = off. Set this before sharing widely.
# GLOBAL_DAILY_LIMIT=300

# Optional allowlist (comma-separated emails or @domain). If set, only these may
# use the app. Leave UNSET for a public free tool. (Open signups in Supabase.)
# ALLOWED_EMAILS=@school.edu,you@example.com
