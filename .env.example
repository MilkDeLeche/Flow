# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.
# Full setup steps: see SETUP.md

# --- Free-tier engine (server only) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (client + auth) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Cloudflare Turnstile (client) ---
# Create at dash.cloudflare.com → Turnstile. Also paste Secret in Supabase Auth → Captcha.
VITE_TURNSTILE_SITE_KEY=

# --- Google OAuth ---
# Configure in Supabase Auth → Providers → Google (see SETUP.md).
# Google Cloud OAuth redirect URI must be:
#   https://YOUR-PROJECT.supabase.co/auth/v1/callback

# --- Email confirmation ---
# Supabase → Authentication → Email → enable "Confirm email"
# Set Site URL + Redirect URLs (localhost + production). See SETUP.md.

# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# APP_ENCRYPTION_KEY=64_hex_chars
# --- Stripe (server only) ---
# Create products/prices in Stripe Dashboard — see SETUP.md §8.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STUDENT=price_...
STRIPE_PRICE_STUDIO=price_...
STRIPE_PRICE_FOCUS_PACK=price_...
APP_URL=https://flowstudy.app
# FREE_LIMIT_HOUR=1
# FREE_LIMIT_DAY=2
